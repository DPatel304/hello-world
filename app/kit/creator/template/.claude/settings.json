{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./game.js)",
      "Read(./orlis.json)",
      "Read(./CLAUDE.md)",
      "Edit(./game.js)",
      "Edit(./orlis.json)"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "NotebookEdit",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.orlis/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.ps1"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check.ps1"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt.ps1"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": false
}
